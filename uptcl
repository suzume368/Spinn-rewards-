import os
import time

import requests
from bs4 import BeautifulSoup

# --- CONFIGURATION ---
TARGET_NUMBER = "03347417367"
BASE_URL = "https://my.ptcl.net.pk"
# ---------------------


class LightSpinner:
    def __init__(self):
        self.session = requests.Session()
        self.headers = {
            "User-Agent": "Mozilla/5.0 (Linux; Android 11) AppleWebKit/537.36",
            "Accept-Language": "en-US,en;q=0.9",
        }
        self.session.headers.update(self.headers)

    def start(self):
        print(f"\n🚀 Target: {TARGET_NUMBER}")

        # 1. Page Load & Tokens
        try:
            resp = self.session.get(f"{BASE_URL}/SpinTheWheel/Default.aspx", timeout=20)
            resp.raise_for_status()
            soup = BeautifulSoup(resp.text, "html.parser")

            view_state = soup.find("input", {"name": "__VIEWSTATE"})
            view_state_generator = soup.find("input", {"name": "__VIEWSTATEGENERATOR"})
            event_validation = soup.find("input", {"name": "__EVENTVALIDATION"})

            if not (view_state and view_state_generator and event_validation):
                raise ValueError("Required ASP.NET form fields not found on page.")

            vs = view_state.get("value", "")
            vsg = view_state_generator.get("value", "")
            ev = event_validation.get("value", "")
        except Exception:
            return print("❌ Connection Error: Website down ya internet check karein.")

        # 2. Get Captcha
        cap_file = "captcha.png"
        try:
            cap_resp = self.session.get(
                f"{BASE_URL}/SpinTheWheel/Captcha.aspx?{int(time.time())}",
                timeout=20,
            )
            cap_resp.raise_for_status()
            with open(cap_file, "wb") as f:
                f.write(cap_resp.content)
            print(f"📸 Captcha saved as: {os.path.abspath(cap_file)}")
        except Exception:
            return print("❌ Captcha download nahi ho saka.")

        # 3. User Input
        code = input("⌨️  Captcha image dekh kar code enter karein: ").strip()

        # 4. Submit Form
        data = {
            "__VIEWSTATE": vs,
            "__VIEWSTATEGENERATOR": vsg,
            "__EVENTVALIDATION": ev,
            "txtMobile": TARGET_NUMBER,
            "txtCaptcha": code,
            "chkTerms": "on",
            "btnNext": "Start Game",
        }

        print("🎡 Submitting...")
        try:
            post_resp = self.session.post(
                f"{BASE_URL}/SpinTheWheel/Default.aspx",
                data=data,
                timeout=20,
            )
            post_resp.raise_for_status()
        except Exception:
            return print("❌ Request failed: Website busy ya server down hai.")

        if "SpinWheel.aspx" in post_resp.url:
            # 5. Spin the Wheel
            try:
                spin_resp = self.session.post(
                    f"{BASE_URL}/SpinTheWheel/SpinWheel.aspx/SpinWheels",
                    json={},
                    timeout=20,
                )
                spin_resp.raise_for_status()
                result = spin_resp.json()
                reward = (
                    result.get("d", {}).get("reward", "No Reward")
                    if isinstance(result.get("d"), dict)
                    else result.get("d")
                )
                print(f"🎉 SUCCESS! Reward: {reward}")
            except Exception:
                print("❌ Spin request fail hui. Shayad session expire ho gayi hai.")
        else:
            print("❌ Failed: Shayad captcha galat hai ya number aaj use ho chuka hai.")

        if os.path.exists(cap_file):
            os.remove(cap_file)


if __name__ == "__main__":
    LightSpinner().start()
